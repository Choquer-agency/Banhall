# Copy to .env.local BEFORE running `npx convex dev`; the CLI fills the three
# names it owns in place, and copying afterwards would blank them again.
# Names only — never commit values.
# Verification needs no deployment: `bash scripts/loop-verify.sh` supplies
# placeholders for the two PUBLIC_CONVEX_* names itself. These are for running
# the real app.

# Set automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=

# Convex deployment URL, also set automatically by `npx convex dev`. Read by
# src/routes/+layout.svelte:11 (setupConvex) and
# src/lib/components/project/ProjectWorkflowMenu.svelte:258 (ConvexHttpClient).
PUBLIC_CONVEX_URL=

# Convex HTTP actions (.convex.site) URL, also set automatically by
# `npx convex dev`. Two consumers: the installed
# @mmailaender/convex-better-auth-svelte SvelteKit adapter imports it from
# $env/static/public (dist/sveltekit/index.js:3), which is what
# src/hooks.server.ts, src/routes/+layout.server.ts and
# src/routes/api/auth/[...all]/+server.ts pull in; and
# scripts/client-uploader/setup.sh:39 reads it straight out of this file.
PUBLIC_CONVEX_SITE_URL=

# Build timestamp shown by src/lib/components/BuildStamp.svelte:10. Vercel sets
# it at build time; blank locally.
PUBLIC_BUILD_TIME=

# --- Convex-side names. Set these on the deployment (`npx convex env set`),
# --- not in this file. Declared in convex/convex.config.ts:20-38 and read in
# --- convex/auth.ts, except BRAIN_CONTEXTUAL, which is read straight from
# --- process.env and is in no schema.
#
# ANTHROPIC_API_KEY            Claude, used in Convex actions only
# VOYAGE_API_KEY               embeddings for The Brain (voyage-3-large)
# OPENROUTER_API_KEY           OpenRouter gateway for generation/research models
# MS_TENANT_ID                 OneDrive corpus sync (Microsoft Graph app-only)
# MS_CLIENT_ID
# MS_CLIENT_SECRET
# MS_DRIVE_ID
# MS_ROOT_PATH                 folder under the drive root (defaults "Applications")
# INGEST_API_KEY               bearer key for the crawler upload endpoint
# SITE_URL                     better-auth baseURL (convex/auth.ts:115)
# BETTER_AUTH_TRUSTED_ORIGINS  comma-separated origins (convex/auth.ts:24)
# BETTER_AUTH_SECRET           better-auth signing secret
# BRAIN_CONTEXTUAL             "1" enables Anthropic Contextual Retrieval on
#                              ingest (convex/ai/brain/ingest.ts:13)
