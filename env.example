# Copy to .env.local before running `npx convex dev` for initial setup.
# Convex provisioning populates these values for SvelteKit. Do not overwrite
# generated values by copying this example again afterward.
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# Optional timestamp supplied at build/deploy time; blank or invalid values
# hide the build stamp. See src/lib/components/BuildStamp.svelte.
PUBLIC_BUILD_TIME=

# Backend-only names: configure on the Convex deployment, not as frontend
# assignments in .env.local.
# Declared optional app environment names in convex/convex.config.ts:
# ANTHROPIC_API_KEY, VOYAGE_API_KEY, OPENROUTER_API_KEY,
# MS_TENANT_ID, MS_CLIENT_ID, MS_CLIENT_SECRET, MS_DRIVE_ID, MS_ROOT_PATH,
# INGEST_API_KEY.
# Voyage models: voyage-3-large (1024 dimensions) and rerank-2.5;
# see convex/ai/brain/embeddings.ts.
# Direct reads outside that app schema:
# SITE_URL (backend auth base URL, distinct from PUBLIC_CONVEX_SITE_URL) and
# BETTER_AUTH_TRUSTED_ORIGINS in convex/auth.ts;
# BRAIN_CONTEXTUAL in convex/ai/brain/ingest.ts: unset disables contextualization;
# "1" adds Anthropic context calls and their cost, using ANTHROPIC_API_KEY.
# Embedding calls remain separate from this switch.
# BETTER_AUTH_SECRET is consumed by installed better-auth and is also absent
# from the app environment schema.
