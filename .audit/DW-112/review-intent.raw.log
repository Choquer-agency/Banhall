   880	/** Run the whole scheduled chain to exhaustion, one job at a time. */
   881	async function drainGeneration(t: TestApp) {
   882	  for (let round = 0; round < 60; round += 1) {
   883	    const [job] = await t.run(async (ctx) =>
   884	      (await ctx.db.system.query("_scheduled_functions").collect()).filter(
   885	        (row) =>
   886	          row.state.kind === "pending" &&
   887	          [CANDIDATE_JOB, SECTION_JOB, FINALIZE_JOB].includes(row.name)
   888	      )
   889	    );
   890	    if (!job) return;
   891	    await t.run((ctx) => ctx.scheduler.cancel(job._id));
   892	    const args = job.args[0] as never;
   893	    if (job.name === CANDIDATE_JOB) {
   894	      await t.action(internal.ai.pipeline.generateCandidate, args);
   895	    } else if (job.name === SECTION_JOB) {
   896	      await t.action(internal.ai.orderedGeneration.generateOrderedSection, args);
   897	    } else {
   898	      await t.action(internal.ai.orderedGeneration.finalizeOrderedCandidate, args);
   899	    }
   900	  }
   901	  throw new Error("the generation chain did not drain");
   902	}
