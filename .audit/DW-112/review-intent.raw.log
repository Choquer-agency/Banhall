   916	/** One call the publish path made through `briefPublishCtx`. */
   917	type BriefStageCall = { name: string; args: Record<string, unknown>; result?: unknown };
   918	
   919	/**
   920	 * `publishDerivedBrief`'s ctx over this test's backend: each call becomes its
   921	 * own `t.query`/`t.mutation` transaction, exactly as `ctx.runQuery` /
   922	 * `ctx.runMutation` are from the action. Every call is recorded, and `before`
   923	 * runs ahead of each one — a case uses it to publish a concurrent version or
   924	 * fail a page read at a precise step.
   925	 */
   926	function briefPublishCtx(
   927	  t: TestApp,
   928	  before?: (call: BriefStageCall, calls: BriefStageCall[]) => Promise<void>
   929	) {
   930	  const calls: BriefStageCall[] = [];
   931	  const run = async (
   932	    kind: "query" | "mutation",
   933	    reference: FunctionReference<"query" | "mutation", "public" | "internal">,
   934	    args: Record<string, unknown> = {}
   935	  ) => {
   936	    const call: BriefStageCall = { name: getFunctionName(reference), args };
   937	    calls.push(call);
   938	    await before?.(call, calls);
   939	    const result =
   940	      kind === "query"
   941	        ? await t.query(reference as FunctionReference<"query", "internal">, args as never)
   942	        : await t.mutation(reference as FunctionReference<"mutation", "internal">, args as never);
   943	    call.result = result;
   944	    return result;
   945	  };
   946	  const ctx = {
   947	    runQuery: (reference, ...args) =>
   948	      run("query", reference, args[0] as Record<string, unknown> | undefined),
   949	    runMutation: (reference, ...args) =>
   950	      run("mutation", reference, args[0] as Record<string, unknown> | undefined),
   951	  } as BriefPublishCtx;
   952	  return { ctx, calls };
   953	}
