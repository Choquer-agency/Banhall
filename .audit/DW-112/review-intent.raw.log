   285	/**
   286	 * The complete diff baseline for a new derivation, already compared with its
   287	 * candidates: the project's newest Brief (pinned by id) and every one of its
   288	 * live rows, however many there are, partitioned by `briefDiffKey`.
   289	 *
   290	 * Each page is its own bounded query transaction (`getBriefDiffBaselinePage`),
   291	 * so no single read grows with the Brief. A `SplitRequired` page may be
   292	 * incomplete, so it is discarded and re-read from the same cursor with half
   293	 * as many rows; a one-row page that still reports it cannot be read within
   294	 * the byte budget and throws. The baseline is complete only when an accepted
   295	 * page reports `isDone` — never a prefix, never a refusal by size.
   296	 *
   297	 * Only compact results outlive a page. A live key some candidate shares keeps
   298	 * a `retained` reference (the row id and the first such candidate's index) and
   299	 * its old text is dropped with the page; a live key no candidate shares keeps
   300	 * its full payload in `removed`, because it becomes a marker. As in the
   301	 * mutation, the last row with a key wins.
   302	 */
   303	export async function readCompleteBriefDiffBaseline(
   304	  ctx: BriefPublishCtx,
   305	  projectId: Id<"projects">,
   306	  candidates: ReadonlyArray<Parameters<typeof briefDiffKey>[0]>
   307	): Promise<{
   308	  briefId: Id<"generationBriefs"> | null;
   309	  retained: BaselineRetained[];
   310	  removed: BaselineRemoved[];
   311	}> {
   312	  const briefId = await ctx.runQuery(internal.generations.getBriefDiffBaselineId, {
   313	    projectId,
   314	  });
   315	  if (briefId === null) return { briefId: null, retained: [], removed: [] };
   316	
   317	  const candidateIndexByKey = new Map<string, number>();
   318	  candidates.forEach((candidate, index) => {
   319	    const key = briefDiffKey(candidate);
   320	    if (!candidateIndexByKey.has(key)) candidateIndexByKey.set(key, index);
   321	  });
   322	  const retainedByKey = new Map<string, BaselineRetained>();
   323	  const removedByKey = new Map<string, BaselineRemoved>();
   324	  let cursor: string | null = null;
   325	  let numItems = MAX_BRIEF_ENTRY_ROWS;
   326	  for (;;) {
   327	    const page: FunctionReturnType<typeof internal.generations.getBriefDiffBaselinePage> =
   328	      await ctx.runQuery(internal.generations.getBriefDiffBaselinePage, {
   329	        briefId,
   330	        cursor,
   331	        numItems,
   332	      });
