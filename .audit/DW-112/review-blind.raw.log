    const { ctx, calls } = briefPublishCtx(t, async (call) => {
      if (call.name !== PERSIST_MUTATION) return;
      const latest = (await newestBriefOf(t, projectId))!;
      edits += 1;
      await asWriter.mutation(anyApi.briefs.saveEntryEdit, {
