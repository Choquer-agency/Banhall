          text: { type: "string" },
          quote: { type: "string", description: "Exact verbatim quote from the evidence." },
        },
        required: ["text", "quote"],
      },
    },
    claimExclusions: {
      type: "array",
      items: {
        type: "object",
        properties: {
          text: { type: "string" },
          quote: { type: "string" },
          reason: { type: "string", enum: [...CLAIM_EXCLUSION_REASONS] },
        },
