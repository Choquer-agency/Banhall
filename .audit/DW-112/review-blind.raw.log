      projectId: args.projectId,
      generationId: args.generationId,
      inputsHash: args.inputsHash,
      version: 1,
      origin: args.origin,
      storylineText: args.storylineText,
      droppedEntryCount,
      createdAt: Date.now(),
    });

    for (const { entry, change } of stampedEntries) {
      await ctx.db.insert("generationBriefEntries", {
        briefId,
        projectId: args.projectId,
        group: entry.group,
        text: entry.text,
        reason: entry.reason,
        confidence: entry.confidence,
        sourceId: entry.sourceId,
        sourceContentHash: entry.sourceContentHash,
        startOffset: entry.startOffset,
        endOffset: entry.endOffset,
        exactExcerpt: entry.exactExcerpt,
        change,
        createdAt: Date.now(),
      });
    }
    for (const removed of markers) {
        ...(_id === targetId ? { ...entryPatch, edited: true } : {}),
        briefId: newBriefId,
        createdAt: now,
      });
    }

    return newBriefId;
  },
