   129	step "unit tests" npm test
   130	step "test discovery guard" node scripts/check-test-discovery.mjs
   131	step "production build" npm run build
   132	# Client-uploader file-selection harnesses: uploader-lib.ps1 (Windows) and the
   133	# scan/upload helpers in banhall-uploader.sh (Mac).
   134	step "uploader harness (pwsh)" pwsh -NoProfile -File scripts/client-uploader/tests/run-tests.ps1
   135	step "uploader harness (bash)" bash scripts/client-uploader/tests/run-tests.sh
   136	if [ "$VERIFY_COMPONENT" = "1" ]; then
   137	  step "component suite" npm run test:component
   138	fi
