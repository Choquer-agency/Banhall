   106	    echo "  Chromium headless launch ok"
   107	  fi
   108	  return 0
   109	}
   110	
   111	# A skipped or vacuous test is a silenced failure, not a passing one. The gate
   112	# refuses tracked test files that skip cases or assert nothing (added 2026-09-10
   113	# after a cheap-model dev session turned a failing suite into test.skip).
   114	no_skipped_tests() {
   115	  local hits
   116	  hits="$(git grep -n -E '\b(test|it|describe)\.skip\(|\b(test|it)\.todo\(|expect\(true\)\.toBe\(true\)' -- '*.test.ts' || true)"
   117	  if [ -n "$hits" ]; then
   118	    echo "loop-verify: skipped or vacuous tests are not allowed:"
   119	    echo "$hits"
   120	    return 1
   121	  fi
   122	  return 0
   123	}
   124	
   125	step preflight preflight
   126	step "no skipped tests" no_skipped_tests
   127	step "convex typecheck" npx tsc -p convex/tsconfig.json --noEmit
