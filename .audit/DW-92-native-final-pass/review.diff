++  type Block = { text: string; heading: boolean; richText?: boolean };
++  function nodeText(node: unknown): string {
++    type TextTask = { kind: "node"; node: unknown } | { kind: "separator" };
++    const pending: TextTask[] = [{ kind: "node", node }];
++    const text: string[] = [];
