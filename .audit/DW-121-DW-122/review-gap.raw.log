    15	export async function selectedCandidateRunId(
    16	  ctx: QueryCtx,
    17	  generation: Doc<"generations">
    18	): Promise<Id<"generationCandidateRuns"> | undefined> {
    19	  if ((generation.candidateMode ?? "compare") !== "compare") return undefined;
    20	  const selection = await ctx.db
    21	    .query("modelSelections")
    22	    .withIndex("by_projectId_and_generationId", (q) =>
    23	      q.eq("projectId", generation.projectId).eq("generationId", generation._id)
    24	    )
    25	    .first();
    26	  if (!selection?.candidateId) return undefined;
    27	  const run = await ctx.db
    28	    .query("generationCandidateRuns")
    29	    .withIndex("by_generationId_and_candidateId", (q) =>
    30	      q.eq("generationId", generation._id).eq("candidateId", selection.candidateId)
    31	    )
    32	    .first();
    33	  return run?._id;
    34	}
    35	
    36	/**
    37	 * Story 2 (CAP-7, AD-25): the one read of Compliance Notes. The QA rail, the
    38	 * Editor's section-end line and the chat Deviation Inventory all read through
    39	 * here. Rows are written only by the ordered section-chain mutations in
    40	 * convex/generations.ts (completeOrderedSectionRun, insertConsistencyNotes).
    41	 *
    42	 * Without a candidateRunId, a compare generation that has a selected report
    43	 * returns the selected candidate's rows (the report inherits them on
    44	 * selectReportCandidate); otherwise every row of the generation is returned.
    45	 */
    46	export const listForGeneration = query({
    47	  args: {
    48	    generationId: v.id("generations"),
    49	    candidateRunId: v.optional(v.id("generationCandidateRuns")),
    50	  },
    51	  handler: async (ctx, args) => {
    52	    const generation = await ctx.db.get(args.generationId);
    53	    if (
    54	      !generation ||
    55	      !(await getInternalProjectAccessOrNull(ctx, generation.projectId))
    56	    ) {
    57	      return [];
    58	    }
    59	    let candidateRunId: Id<"generationCandidateRuns"> | undefined =
    60	      args.candidateRunId;
    61	    if (candidateRunId === undefined) {
    62	      candidateRunId = await selectedCandidateRunId(ctx, generation);
    63	    }
    64	    if (candidateRunId !== undefined) {
    65	      const scoped = candidateRunId;
    66	      return await ctx.db
    67	        .query("complianceNotes")
    68	        .withIndex("by_generationId_and_candidateRunId_and_section", (q) =>
    69	          q.eq("generationId", generation._id).eq("candidateRunId", scoped)
    70	        )
    71	        .take(1000);
    72	    }
    73	    return await ctx.db
    74	      .query("complianceNotes")
    75	      .withIndex("by_generationId_and_section", (q) =>
    76	        q.eq("generationId", generation._id)
    77	      )
    78	      .take(1000);
    79	  },
    80	});

