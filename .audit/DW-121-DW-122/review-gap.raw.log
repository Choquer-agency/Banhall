  4449	    const runStatus = new Map<string, string | undefined>();
  4450	    for (const key of lastIndex.keys()) {
  4451	      const run = await ctx.db.get(key as Id<"generationCandidateRuns">);
  4452	      checkedAt.set(key, run?.consistencyCheckedAt);
  4453	      runStatus.set(key, run?.status);
  4454	    }
  4455	    return rows
  4456	      .filter((row) => row.status === "drafted" && row.draftText !== undefined)
  4457	      .filter((row) => {
  4458	        const key = row.candidateRunId as string;
  4459	        // A failed candidate's earlier drafted sections are not a valid
  4460	        // draft to show: the run never reached completion.
  4461	        return runStatus.get(key) !== "failed";
  4462	      })
  4463	      .filter((row) => {
  4464	        const key = row.candidateRunId as string;
  4465	        return (
  4466	          (row.orderIndex ?? 0) !== lastIndex.get(key) ||
  4467	          checkedAt.get(key) !== undefined
