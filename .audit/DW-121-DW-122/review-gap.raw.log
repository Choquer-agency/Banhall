   740	/** The delimiter `lib/briefRender.ts` wraps a rendered Brief in. */
   741	const BRIEF_BLOCK_MARKER = "--- BEGIN [GENERATION BRIEF] ---";
   742	/** Shared prefix of every row `seedOverBoundBrief` writes, so a test can
   743	 * assert no individual row leaked, not merely that the block is absent. */
   744	const OVER_BOUND_ENTRY_TEXT = "over-bound exclusion";
   745	
   746	/**
   747	 * A stored Brief that is over the entry-row bound and therefore unreadable.
   748	 * Reachable in production two ways (neither passes through the derivation's
   749	 * fail-open catch): `ai/brief.ts:289-305` reuses a Brief by parent row alone,
   750	 * and `persistDerivedBrief`'s `entries` argument is uncapped. Every
   751	 * generation consumer must omit it whole and keep drafting — a throw from
   752	 * `loadBriefCheck` would roll the section's CAS claim back and strand the row
   753	 * `queued` (`orderedGeneration.ts:173-178` sits outside its `try` at `:200`).
   754	 */
   755	async function seedOverBoundBrief(
   756	  t: ReturnType<typeof convexTest>,
   757	  ids: { projectId: Id<"projects">; generationId: Id<"generations"> }
   758	) {
   759	  await t.run(async (ctx) => {
   760	    const source = (await ctx.db.query("generationSources").collect()).find(
   761	      (row) => row.generationId === ids.generationId
   762	    );
   763	    if (!source) throw new Error("frozen source missing");
   764	    const now = Date.now();
   765	    const briefId = await ctx.db.insert("generationBriefs", {
   766	      projectId: ids.projectId,
   767	      generationId: ids.generationId,
   768	      inputsHash: "over-bound-brief",
   769	      version: 1,
   770	      origin: "derived",
   771	      storylineText: "A Storyline no prompt may ever see in part.",
   772	      createdAt: now,
   773	    });
   774	    for (let i = 0; i <= MAX_BRIEF_ENTRY_ROWS; i += 1) {
   775	      await ctx.db.insert("generationBriefEntries", {
   776	        briefId,
   777	        projectId: ids.projectId,
   778	        group: "claimExclusion",
   779	        text: `${OVER_BOUND_ENTRY_TEXT} ${i}`,
   780	        reason: "business_risk",
   781	        sourceId: source._id,
   782	        sourceContentHash: source.contentHash,
   783	        startOffset: 0,
   784	        endOffset: 1,
   785	        exactExcerpt: source.content.slice(0, 1),
   786	        createdAt: now,
   787	      });
   788	    }
   789	    await ctx.db.patch(ids.generationId, { briefId });
   790	  });
   791	}
