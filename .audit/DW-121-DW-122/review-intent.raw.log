  4416	    ) {
  4417	      return null;
  4418	    }
  4419	    if ((generation.candidateMode ?? "compare") === "iterative") return [];
  4420	    const candidateRunId = args.candidateRunId;
  4421	    if (candidateRunId !== undefined) {
  4422	      const candidateRun = await ctx.db.get(candidateRunId);
  4423	      if (!candidateRun || candidateRun.generationId !== generation._id) return [];
  4424	    }
  4425	    const rows = (
  4426	      candidateRunId === undefined
  4427	        ? await ctx.db
  4428	            .query("generationSectionRuns")
  4429	            .withIndex("by_generationId", (q) => q.eq("generationId", generation._id))
  4430	            .take(30)
  4431	        : await ctx.db
  4432	            .query("generationSectionRuns")
  4433	            .withIndex("by_candidateRunId_and_section", (q) =>
  4434	              q.eq("candidateRunId", candidateRunId)
  4435	            )
  4436	            .take(30)
  4437	    ).filter(
  4438	      (row) =>
  4439	        row.generationId === generation._id &&
  4440	        row.candidateRunId !== undefined &&
  4441	        (candidateRunId === undefined || row.candidateRunId === candidateRunId)
  4442	    );
  4443	    const lastIndex = new Map<string, number>();
  4444	    for (const row of rows) {
  4445	      const key = row.candidateRunId as string;
  4446	      lastIndex.set(key, Math.max(lastIndex.get(key) ?? -1, row.orderIndex ?? 0));
  4447	    }
