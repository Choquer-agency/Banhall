+function chatReadBudget() {
+  let used = 0;
+  let exhausted = false;
+  function reserve(): boolean {
+    if (used + CHAT_DOCUMENT_HEADROOM <= CHAT_READ_BYTES) return true;
+    exhausted = true;
+    return false;
+  }
