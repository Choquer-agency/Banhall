   254	    const { best: r, runnerUp } = bestAndRunnerUp(row);
   255	    const score = row[r]!;
   256	    if (score < MIN_COUNTERPART_SIMILARITY || score - runnerUp < COUNTERPART_MARGIN) {
   257	      return undefined;
   258	    }
