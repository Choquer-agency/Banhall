   207	/** Sørensen–Dice over two word bags: 0 (nothing shared) to 1 (identical). */
   208	function bagSimilarity(a: Map<string, number>, b: Map<string, number>): number {
   209	  let sizeA = 0;
   210	  let sizeB = 0;
   211	  let overlap = 0;
   212	  for (const [word, count] of a) {
   213	    sizeA += count;
   214	    overlap += Math.min(count, b.get(word) ?? 0);
   215	  }
   216	  for (const count of b.values()) sizeB += count;
   217	  return sizeA + sizeB === 0 ? 0 : (2 * overlap) / (sizeA + sizeB);
   218	}
