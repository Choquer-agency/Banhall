   222	  let best = -1;
   223	  let runnerUp = 0;
   224	  scores.forEach((score, index) => {
   225	    if (best === -1 || score > scores[best]!) {
   226	      runnerUp = best === -1 ? 0 : scores[best]!;
   227	      best = index;
   228	    } else if (score > runnerUp) {
   229	      runnerUp = score;
   230	    }
   231	  });
   232	  return { best, runnerUp };
