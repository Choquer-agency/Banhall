+  const bag = new Map<string, number>();
+  for (const raw of text.toLowerCase().split(/[^\p{L}\p{N}]+/u)) {
+    if (!raw || ALIGNMENT_STOP_WORDS.has(raw)) continue;
+    bag.set(raw, (bag.get(raw) ?? 0) + 1);
+  }
