  1423	  generationId: Id<"generations">,
  1424	  error: string
  1425	) {
  1426	  const runs = await ctx.db
  1427	    .query("generationCandidateRuns")
  1428	    .withIndex("by_generationId", (q) => q.eq("generationId", generationId))
  1429	    .take(10);
  1430	  for (const run of runs) {
  1431	    if (run.status !== "queued" && run.status !== "running") continue;
  1432	    await ctx.db.patch(run._id, {
  1433	      status: "failed",
  1434	      error,
  1435	      completedAt: Date.now(),
  1436	    });
  1437	  }
  1438	}
  1439	
  1440	export const failGeneration = internalMutation({
  1441	  args: {
  1442	    generationId: v.id("generations"),
  1443	    error: v.string(),
  1444	  },
  1445	  handler: async (ctx, args) => {
  1446	    const generation = await ctx.db.get(args.generationId);
  1447	    if (
  1448	      !generation ||
  1449	      (generation.status !== "reserved" && generation.status !== "running")
  1450	    ) {
  1451	      return;
  1452	    }
  1453	    await ctx.db.patch(generation._id, {
  1454	      status: "failed",
  1455	      currentStep: "Failed",
  1456	      error: args.error.slice(0, 500),
  1457	      completedAt: Date.now(),
  1458	    });
  1459	    await terminalizeOrphanedCandidateRuns(
  1460	      ctx,
  1461	      generation._id,
  1462	      "The generation failed before this draft completed."
  1463	    );
  1464	    const project = await ctx.db.get(generation.projectId);
  1465	    if (project?.activeGenerationId === generation._id) {
  1466	      await ctx.db.patch(project._id, {
  1467	        activeGenerationId: undefined,
  1468	        status: generation.previousProjectStatus ?? "draft",
  1469	        updatedAt: Date.now(),
  1470	      });
  1471	    }
  1472	    await refreshProjectGenerationActivity(ctx, generation.projectId);
  1473	  },
  1474	});
