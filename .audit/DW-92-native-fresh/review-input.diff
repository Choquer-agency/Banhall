diff --git a/.audit/DW-92-native-fresh/verify.py b/.audit/DW-92-native-fresh/verify.py
new file mode 100644
index 0000000..f783051
--- /dev/null
+++ b/.audit/DW-92-native-fresh/verify.py
@@ -0,0 +1,30 @@
+"""Execute ordinary gates and retain actual command provenance and log hashes."""
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+AUDIT = Path(__file__).resolve().parent
+ROOT = AUDIT.parents[1]
+
+def git(*args):
+    return subprocess.check_output(['git', *args], cwd=ROOT)
+
+records = []
+for filename, command in [
+    ('parent-ordinary.log', ['bash', 'scripts/loop-verify.sh']),
+    ('parent-focused.log', ['npx', 'vitest', 'run', 'convex/ai/qaChecks.test.ts', 'convex/projects.test.ts', 'convex/qaBlocking.test.ts']),
+]:
+    record = {'command': command, 'cwd': str(ROOT), 'revision': git('rev-parse', 'HEAD').decode().strip(),
+              'started': datetime.now(timezone.utc).isoformat(), 'log': filename,
+              'source_diff_sha256': hashlib.sha256(git('diff', 'HEAD', '--', 'convex', 'src', 'shared', 'scripts', 'package.json', 'package-lock.json', 'tsconfig.json', 'vitest.config.ts')).hexdigest()}
+    print('RUN ' + ' '.join(command), flush=True)
+    with (AUDIT / filename).open('wb') as log:
+        result = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
+    record.update(exit_code=result.returncode, ended=datetime.now(timezone.utc).isoformat(), sha256=hashlib.sha256((AUDIT / filename).read_bytes()).hexdigest())
+    records.append(record)
+    (AUDIT / 'commands.json').write_text(json.dumps(records, indent=2) + '\n')
+    print('EXIT ' + str(result.returncode), flush=True)
+    if result.returncode:
+        raise SystemExit(result.returncode)
