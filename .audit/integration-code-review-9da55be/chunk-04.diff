+const modules = import.meta.glob("./**/*.ts");
+const AUTH_ID = "lifecycle-writer";
+/** A writer who owns nothing on the fixture project and holds no work item. */
+const OUTSIDER_AUTH_ID = "lifecycle-outsider";
