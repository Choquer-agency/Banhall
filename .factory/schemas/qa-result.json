{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "verdict",
    "evidence_path",
    "summary",
    "checks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "failed",
        "needs_operator"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "live-verified",
        "test-verified",
        "typecheck-only",
        "unproven"
      ]
    },
    "evidence_path": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result",
          "level",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
